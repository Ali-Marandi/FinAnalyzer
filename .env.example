# FinAnalyzer Enterprise — local integration configuration
# Copy to .env or set these values in the Windows user environment. Never commit real values.

# Plaid: start in Sandbox; use Production only after required provider and compliance approvals.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=FinAnalyzer Enterprise
PLAID_COUNTRY_CODES=US
PLAID_DAYS_REQUESTED=90
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=

# Optional enterprise-controlled Fernet key. Leave blank to create a local user-scoped key.
FINANALYZER_MASTER_KEY=

# Optional SMTP delivery for scheduled reports.
FINANALYZER_SMTP_HOST=
FINANALYZER_SMTP_PORT=587
FINANALYZER_SMTP_USERNAME=
FINANALYZER_SMTP_PASSWORD=
FINANALYZER_EMAIL_FROM=

# Optional Telegram delivery for scheduled reports.
FINANALYZER_TELEGRAM_BOT_TOKEN=
